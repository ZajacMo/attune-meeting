# Normalise line endings: keep LF in the repository for every platform.
* text=auto eol=lf

*.py   text eol=lf
*.pyi  text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf

*.wav  binary
*.mp3  binary
*.m4a  binary
*.mp4  binary
*.onnx binary
*.bin  binary
